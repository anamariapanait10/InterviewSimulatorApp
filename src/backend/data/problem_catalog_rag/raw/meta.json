    "id": "meta-valid-palindrome",
    "title": "Valid Palindrome",
    "company": "Meta",
    "difficulty": "easy",
    "prompt": "Given a string s, return true if it is a palindrome after converting uppercase letters to lowercase and removing all non-alphanumeric characters.",
    "constraints": [
      "1 <= s.length <= 200000"
    ],
    "examples": [
      { "input": "s = \"A man, a plan, a canal: Panama\"", "output": "true" },
      { "input": "s = \"race a car\"", "output": "false" }
    ],
    "starter_template": {
      "kind": "function",
      "name": "isPalindrome",
      "typescript_params": "s: string",
      "python_params": "s: str",
      "java_signature": "boolean isPalindrome(String s)",
      "csharp_signature": "bool IsPalindrome(string s)"
    },
    "expected_topics": ["two pointers", "string normalization"],
    "style_tags": ["text cleanup", "pointer reasoning"],
    "complexity_target": "Process the string in linear time.",
    "edge_case_hints": ["empty after filtering", "numbers", "mixed punctuation"]
  },
  {
